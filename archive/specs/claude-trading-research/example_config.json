{
  "system": {
    "account_equity": 25000,
    "broker": "REPLACE_ME",
    "mode": "backtest",
    "require_human_approval": true,
    "timezone": "America/New_York",
    "monthly_return_target": 4.0
  },
  "risk": {
    "core": { "max_risk_per_trade_pct": 0.02, "kelly_fraction": 0.5, "max_concurrent_risk_pct": 0.08, "max_same_direction_0dte_positions": 2 },
    "convex": { "monthly_budget_pct": 0.10, "max_premium_per_trade_pct": 0.01, "allow_refill_from_core": false },
    "global": {
      "daily_loss_limit_pct": 0.05, "weekly_loss_limit_pct": 0.10, "monthly_dd_kill_switch_pct": 0.20,
      "defined_risk_only": true, "order_type": "limit", "max_price_walk_steps": 3,
      "max_leg_spread_pct_0dte": 0.10, "max_leg_spread_pct_multiday": 0.05,
      "no_new_0dte_after": "15:30", "flatten_physically_settled_by": "15:50",
      "macro_blackout_minutes_before": 10, "macro_blackout_minutes_after": 15
    }
  },
  "regime": { "refresh_minutes": 15, "gex_source": "estimated_from_oi" },
  "strategies": [
    {
      "id": "S1_vwap_z_reversion", "sleeve": "CORE", "enabled": true, "status": "research",
      "underlyings": ["SPX"], "dte": [0, 0], "entry_window": ["10:00", "14:30"],
      "filters": { "vol_level_in": ["LOW", "MID"], "gamma_in": ["POSITIVE"], "allow_event_day": false },
      "signal": {
        "z_entry": { "min": 1.75, "max": 2.5, "step": 0.25, "default": 2.0 },
        "lookback_min": { "min": 20, "max": 60, "step": 10, "default": 30 },
        "require_confirmation_bar": true
      },
      "structure": { "type": "debit_vertical", "long_delta": 0.40, "min_reward_risk": 1.5 },
      "exits": {
        "take_profit": [{ "kind": "pct_of_max_profit", "value": 0.70 }, { "kind": "underlying_level", "value": "VWAP" }],
        "stop_loss": [{ "kind": "zscore_exceeds", "value": 3.0 }, { "kind": "pct_of_debit", "value": 0.50 }],
        "time_stop": "45m"
      }
    },
    {
      "id": "S2_gap_fade", "sleeve": "CORE", "enabled": true, "status": "research",
      "underlyings": ["SPX"], "dte": [0, 0], "entry_window": ["09:45", "10:15"],
      "filters": { "gamma_in": ["POSITIVE"], "allow_event_day": false, "custom": { "gap_pct_min": 0.003, "gap_pct_max": 0.01 } },
      "signal": { "first_bar_minutes": 15, "require_no_new_extreme": true },
      "structure": { "type": "debit_vertical", "long_delta": 0.45 },
      "exits": {
        "take_profit": [{ "kind": "underlying_level", "value": "gap_50pct_fill" }],
        "stop_loss": [{ "kind": "underlying_level", "value": "beyond_opening_range" }],
        "time_stop": "12:00"
      }
    },
    {
      "id": "S3_vix_spike_reversal", "sleeve": "CORE", "enabled": true, "status": "research",
      "underlyings": ["SPX"], "dte": [3, 7], "entry_window": ["15:30", "15:55"],
      "filters": { "vol_level_in": ["MID", "HIGH", "CRISIS"], "allow_event_day": false },
      "signal": {
        "vix_rise_pct_min": 0.25, "vix_rise_lookback_sessions": { "min": 1, "max": 5, "default": 3 },
        "vix_vix3m_peak_min": 1.05, "require_vix_vix3m_falling": true, "require_spx_close_above_prior_high": true
      },
      "structure": { "type": "credit_vertical", "short_delta": 0.20, "min_credit_pct_of_width": 0.25 },
      "exits": {
        "take_profit": [{ "kind": "pct_of_credit", "value": 0.50 }],
        "stop_loss": [{ "kind": "pct_of_credit", "value": 2.0 }, { "kind": "indicator_cross", "value": "VIX_new_spike_high" }],
        "time_stop": "5sessions"
      }
    },
    {
      "id": "S4_0dte_vrp_condor", "sleeve": "CORE", "enabled": true, "status": "research",
      "underlyings": ["SPX"], "dte": [0, 0], "entry_window": ["10:00", "11:00"],
      "filters": { "vol_level_in": ["LOW", "MID"], "gamma_in": ["POSITIVE"], "allow_event_day": false, "custom": { "vix1d_over_vix_max": 1.0 } },
      "signal": { "implied_over_forecast_rv_min": { "min": 1.1, "max": 1.5, "step": 0.1, "default": 1.2 }, "rv_model": "HAR" },
      "structure": { "type": "iron_condor", "short_delta": 0.12, "wing_width": 15, "min_credit_pct_of_width": 0.20 },
      "exits": {
        "take_profit": [{ "kind": "pct_of_credit", "value": 0.50 }],
        "stop_loss": [{ "kind": "short_delta_exceeds", "value": 0.30 }, { "kind": "pct_of_credit", "value": 1.5 }],
        "time_stop": "15:50"
      }
    },
    {
      "id": "S5_oversold_bounce", "sleeve": "CORE", "enabled": true, "status": "research",
      "underlyings": ["XSP", "SPX"], "dte": [2, 5], "entry_window": ["15:45", "15:55"],
      "filters": { "custom": { "spy_above_sma200": true } },
      "signal": { "rsi2_max": 10, "ibs_max": 0.15, "logic": "OR" },
      "structure": { "type": "debit_vertical", "long_delta": 0.50 },
      "exits": {
        "take_profit": [{ "kind": "indicator_cross", "value": "RSI2>65" }, { "kind": "indicator_cross", "value": "close>prior_high" }],
        "stop_loss": [{ "kind": "pct_of_debit", "value": 0.50 }],
        "time_stop": "5sessions"
      }
    },
    {
      "id": "S6_earnings_iv_crush", "sleeve": "CORE", "enabled": false, "status": "research",
      "underlyings": ["DYNAMIC_EARNINGS_LIST"], "dte": [1, 7], "entry_window": ["15:40", "15:50"],
      "filters": { "custom": { "implied_gt_realized_hit_rate_min": 0.70, "median_realized_over_implied_max": 0.80, "lookback_reports": 12, "max_atm_spread_pct": 0.05, "max_names_per_day": 4, "max_risk_per_name_pct": 0.01 } },
      "signal": {},
      "structure": { "type": "iron_fly", "wing_width": "1.5x_implied_move" },
      "exits": { "take_profit": [], "stop_loss": [], "time_stop": "next_open+15m" }
    },
    {
      "id": "S7_trend_day_convexity", "sleeve": "CONVEX", "enabled": true, "status": "research",
      "underlyings": ["SPX", "XSP"], "dte": [0, 0], "entry_window": ["10:00", "13:30"],
      "filters": { "gamma_in": ["NEGATIVE"], "term_structure_in": ["BACKWARDATION", "FLAT", "CONTANGO"], "custom": { "gamma_or_backwardation": true, "or_width_over_implied_move_max": 0.6 } },
      "signal": { "opening_range_minutes": 30, "breakout_bar_minutes": 5, "rel_volume_min": 1.5 },
      "structure": { "type": "long_single", "long_delta": 0.12 },
      "exits": {
        "take_profit": [
          { "kind": "multiple_of_premium", "value": 3, "fraction_to_close": 0.3333 },
          { "kind": "multiple_of_premium", "value": 6, "fraction_to_close": 0.5 }
        ],
        "stop_loss": [{ "kind": "underlying_level", "value": "opening_range_mid" }],
        "time_stop": "15:45"
      }
    }
  ],
  "validation": {
    "min_history_years": 2, "fill_model": "worse_of_both", "fee_per_contract": 0.65,
    "walk_forward": { "train_months": 6, "test_months": 1 },
    "min_oos_trades_core": 100, "min_oos_trades_convex": 50,
    "min_profit_factor": 1.3, "min_deflated_sharpe": 0.0, "max_drawdown_pct": 0.25,
    "paper_sessions_required": 20, "paper_to_backtest_expectancy_min_ratio": 0.5,
    "live_ramp": [0.25, 0.5, 1.0], "decay_window_trades": 50
  }
}
